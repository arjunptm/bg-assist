{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bg-assistant-development",
  "main": "worker/index.ts",
  "compatibility_date": "2025-08-23",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bg-assistant-development",
      "database_id": "a1c5866a-0653-49d4-8a76-cb33a5949630",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  },
  "env": {
    "production": {
      "name": "bg-assistant",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bg-assistant-production",
          "database_id": "29a1b88f-b180-4bd6-ad40-e0225582e6a2",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
