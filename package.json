{
  "name": "bg-assistant",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "build:production": "node scripts/run-production.mjs build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote:list": "wrangler d1 migrations list bg-assistant-development --remote",
    "db:remote:migrate": "wrangler d1 migrations apply bg-assistant-development --remote",
    "db:production:list": "wrangler d1 migrations list bg-assistant-production --remote --env production",
    "db:production:migrate": "wrangler d1 migrations apply bg-assistant-production --remote --env production",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:production": "node scripts/run-production.mjs deploy",
    "deploy:preview": "pnpm run build && wrangler versions upload"
  },
  "dependencies": {
    "hono": "^4.9.2",
    "idb": "^8.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "workbox-window": "^7.4.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "miniflare": "4.20260722.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.33.1"
  }
}
